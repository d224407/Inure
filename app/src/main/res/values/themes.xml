<resources>
    <!-- Base application theme. -->
    <style name="Inure" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- This will fix purple status bar issue when app is launched-->
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="colorAppAccent">@color/inure</item>
        <item name="colorAppAccentLight">@color/inure_light</item>

        <!-- Material 3 color roles, unified with Inure's own accent-color system
             so every stock Material 3 widget (dialogs, buttons, switches, snackbars)
             follows the user's chosen accent instead of the default M3 palette. -->
        <item name="colorPrimary">?attr/colorAppAccent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">?attr/colorAppAccentLight</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
        <item name="colorSecondary">?attr/colorAppAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorTertiary">?attr/colorAppAccentLight</item>
        <item name="colorOnTertiary">@android:color/black</item>

        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:colorEdgeEffect">?attr/colorAppAccent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Inure.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAppAccent">@color/inure</item>
        <item name="colorAppAccentLight">@color/inure_light</item>
        <item name="colorPrimary">?attr/colorAppAccent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">?attr/colorAppAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme" parent="@android:style/Theme.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
